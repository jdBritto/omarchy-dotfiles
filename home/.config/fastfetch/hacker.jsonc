// Bienvenida de Zsh en Kitty (estilo hacker). Se usa desde ~/.zshrc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": { "1": "#00ff9c", "2": "#00e5ff" },
    "padding": { "top": 0, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#00e5ff", "title": "#00ff9c" },
    "key": { "width": 9 }
  },
  "modules": [
    { "type": "os",       "key": "󰣇 os" },
    { "type": "kernel",   "key": " kernel" },
    { "type": "uptime",   "key": "󰅐 uptime" },
    { "type": "packages", "key": "󰏖 pkgs", "format": "{all} ({pacman} pacman, {flatpak-all} flatpak)" },
    { "type": "wm",       "key": " wm" },
    { "type": "cpu",      "key": " cpu", "format": "{name}" },
    { "type": "memory",   "key": " ram" },
    { "type": "disk",     "key": "󰋊 disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
