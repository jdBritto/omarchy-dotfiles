#!/usr/bin/env bash
# Muestra "interfaz ip" de la primera VPN activa (tun*, wg*, ppp*, fctvpn*). Nada si no hay.
for dev in /sys/class/net/*; do
  name=${dev##*/}
  case $name in tun*|wg*|ppp*|fctvpn*|tap*) ;; *) continue ;; esac
  ip=$(ip -4 -o addr show dev "$name" 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
  [ -n "$ip" ] && { echo "$name $ip"; exit 0; }
done
exit 1
