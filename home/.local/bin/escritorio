#!/bin/bash
# Cambia entre DankMaterialShell (DMS) y el escritorio original de Omarchy.
#
#   escritorio dms       -> usar DankMaterialShell
#   escritorio omarchy   -> volver al escritorio de Omarchy
#   escritorio ii        -> illogical-impulse con end4-pC (pide reiniciar)
#   escritorio alternar  -> cambiar al otro
#   escritorio estado    -> mostrar cual esta activo
#   escritorio arranque  -> (uso interno) se ejecuta al iniciar sesion

MODE_FILE="$HOME/.config/escritorio-modo"
OMARCHY_SHELL_DIR="${OMARCHY_PATH:-/usr/share/omarchy}/shell"

modo() { [[ -f $MODE_FILE ]] && cat "$MODE_FILE" || echo omarchy; }

stop_omarchy_shell() {
  # Un cierre limpio hace que omarchy-launch-shell termine sin relanzarlo.
  while timeout 30 quickshell kill -p "$OMARCHY_SHELL_DIR" --any-display >/dev/null 2>&1; do :; done
}

start_dms() {
  pgrep -x dms >/dev/null || hyprctl dispatch 'hl.dsp.exec_cmd("dms run")' >/dev/null
}

stop_dms() {
  dms kill >/dev/null 2>&1
  pkill -x dms 2>/dev/null
  return 0
}

# Entrar o salir de illogical-impulse cambia toda la configuracion de Hyprland
# y la sesion de inicio: eso lo hace `sesion`, que ofrece reiniciar.
salir_de_ii() {
  [[ $(modo) == ii ]] || return 0
  echo "$1" >"$MODE_FILE"
  exec sesion hyprland
}

case "${1:-estado}" in
  ii)
    exec sesion ii
    ;;
  dms)
    salir_de_ii dms
    echo dms >"$MODE_FILE"
    stop_omarchy_shell
    start_dms
    hyprctl reload >/dev/null
    echo "DankMaterialShell activado."
    ;;
  omarchy)
    salir_de_ii omarchy
    echo omarchy >"$MODE_FILE"
    stop_dms
    hyprctl reload >/dev/null
    omarchy-restart-shell
    echo "Escritorio de Omarchy activado."
    ;;
  alternar)
    [[ $(modo) == omarchy ]] && exec "$0" dms || exec "$0" omarchy
    ;;
  arranque)
    [[ $(modo) == dms ]] || exit 0
    # Esperar a que el shell de Omarchy arranque y reemplazarlo por DMS.
    for _ in $(seq 1 100); do
      quickshell list -a -j 2>/dev/null | grep -q "$OMARCHY_SHELL_DIR" && break
      sleep 0.1
    done
    stop_omarchy_shell
    start_dms
    ;;
  estado)
    echo "Escritorio activo: $(modo)"
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
