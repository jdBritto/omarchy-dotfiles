#!/bin/bash
# Elige con que escritorio arranca el equipo.
#
#   sesion hyprland   -> Omarchy (Hyprland). Con `escritorio` eliges DMS u Omarchy.
#   sesion ii         -> Hyprland con illogical-impulse (shell end4-pC)
#   sesion niri       -> Niri con DankMaterialShell
#   sesion alternar   -> cambiar entre Hyprland y Niri
#   sesion estado     -> mostrar cual esta elegido
#
# Despues de cambiar pregunta si quieres reiniciar el equipo ahora.
# (Se reinicia el equipo entero: si solo se reinicia la sesion, la anterior
# queda activa por detras y la nueva arranca con la pantalla en negro.)

CONF=/etc/sddm.conf.d/autologin.conf
MODE_FILE="$HOME/.config/escritorio-modo"

modo() { [[ -f $MODE_FILE ]] && cat "$MODE_FILE" || echo omarchy; }

actual() {
  if grep -q '^Session=niri' "$CONF" 2>/dev/null; then echo niri
  elif [[ $(modo) == ii ]]; then echo ii
  else echo hyprland; fi
}

# illogical-impulse no se lleva bien con UWSM (lo dice su instalador), asi que
# usa la sesion "Hyprland" normal; Omarchy usa la suya (omarchy.desktop, con UWSM).
cambiar() {
  local nombre=$1 archivo=$2
  if [[ $nombre == ii ]]; then
    echo ii >"$MODE_FILE"
  elif [[ $nombre == hyprland && $(modo) == ii ]]; then
    echo omarchy >"$MODE_FILE"
  fi
  if [[ ! -f $CONF ]]; then
    echo "Este equipo no entra solo: en la pantalla de inicio elige \"${archivo%.desktop}\""
    echo "(el menu de sesion, abajo). Queda recordado para la proxima vez."
    return
  fi
  if grep -q "^Session=$archivo" "$CONF"; then
    echo "Ya estaba elegido: $nombre"
  else
    sudo sed -i "s|^Session=.*|Session=$archivo|" "$CONF" || exit 1
    echo "Al iniciar sesion se usara: $nombre"
  fi
  read -rp "Reiniciar el equipo ahora? Se cerraran todas las ventanas. [s/N] " r
  if [[ $r =~ ^[sSyY]$ ]]; then systemctl reboot; else echo "El cambio se aplica al reiniciar el equipo."; fi
}

case "${1:-estado}" in
  niri)     cambiar niri niri.desktop ;;
  hyprland) cambiar hyprland omarchy.desktop ;;
  ii)
    [[ -f $HOME/.config/hypr/ii.lua ]] || { echo "illogical-impulse no esta instalado: ii-dots instalar"; exit 1; }
    cambiar ii hyprland.desktop ;;
  alternar) [[ $(actual) == niri ]] && exec "$0" hyprland || exec "$0" niri ;;
  estado)   echo "Sesion elegida: $(actual)" ;;
  *)        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
